# Build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo lock for libraries (keep for binaries)
# Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node data
/data/
/logs/

# Keys (never commit real keys!)
/keys/
*.pem
*.key

# Configuration with secrets
rope.toml
.env
.env.*

# Test artifacts
*.profraw
coverage/

# Local editor / deploy backups (never commit)
*.bak-*
**/__pycache__/

# Foundry / Node contract tooling
contracts/node_modules/
contracts/artifacts/
contracts/typechain-types/

# Ephemeral rustup/toolchain dirs (accidental cwd artifacts)
**/.rustup/
examples/phase2-signed-rpc/target/

# Anvil/Reth state dumps and snapshots (large binary blobs, recoverable from VPS backups)
deploy/anvil-state-dump-*.hex
deploy/reth-state-snapshot-*.hex
deploy/*-state-*.hex

