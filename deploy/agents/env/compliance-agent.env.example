# /etc/compliance-agent/config.env
# Per-host overrides for ComplianceAgent.

# Defaults already wired in the unit:
#   COMPLIANCE_LISTEN=127.0.0.1:9091
#   COMPLIANCE_RPC_URL=http://127.0.0.1:8545
#   COMPLIANCE_AGENT_WALLET=0x…C005
#   COMPLIANCE_KEY_PATH=/etc/compliance-agent/compliance.seed
#   COMPLIANCE_REPORT_INTERVAL_SECS=900       # MiFID II / DORA digest every 15 min
#   COMPLIANCE_LOG=info,compliance_agent=info

# Useful overrides:
# COMPLIANCE_ALLOWED_REQUESTORS=0xabc…,0xdef…    # allow-list for GDPR Art. 17 callers
# COMPLIANCE_TREX_MODULE=0x0919BAf7e91785Ae65351698a04b07BB13d14bBc
# COMPLIANCE_REQUIRE_JURISDICTION=EU             # reject Art. 17 requests outside EU
# COMPLIANCE_DRY_RUN=1                           # validate Art. 17 requests without untying
