# /etc/insurance-agent/config.env
# Per-host overrides for InsuranceAgent.

# Defaults already wired in the unit:
#   INSURANCE_RPC_URL=http://127.0.0.1:8545
#   INSURANCE_TANASTOK_URL=https://tanastok.io/api/v1/tokenized-assets?limit=500
#   INSURANCE_AGENT_WALLET=0x…C003
#   INSURANCE_INTERVAL_SECS=3600
#   INSURANCE_REATTEST_AFTER_SECS=86400
#   INSURANCE_LOG=info,insurance_agent=info

# Useful overrides:
# INSURANCE_INTERVAL_SECS=1800             # refresh every 30 min instead of 1h
# INSURANCE_REATTEST_AFTER_SECS=43200      # re-attest every 12h instead of 24h
# INSURANCE_NO_TANASTOK=1                  # disable Tanastok feed (dev only)
# INSURANCE_NATURAPROOF_URL=https://...    # plug a real NaturaProof feed
