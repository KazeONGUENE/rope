# /etc/oracle-agent/config.env
# Per-host overrides for OracleAgent. Loaded AFTER /etc/datachain-agents/shared.env
# so values here win.

# Override the canonical wallet only if you've registered a per-host
# OracleAgent identity. Default (set in the unit) is 0x…C002.
# ORACLE_WALLET_HEX=0x…

# Defaults already wired in the unit:
#   ORACLE_FEED_URL=https://dcswap.net/v1/prices
#   ORACLE_RPC_URL=http://127.0.0.1:8545
#   ORACLE_INTERVAL_SECS=60
#   ORACLE_KEY_PATH=/etc/oracle-agent/oracle.seed
#   ORACLE_SIGNING_MODE=hybrid    # hybrid | ed25519-only
#   ORACLE_LOG=info,oracle_agent=info

# Useful overrides:
# ORACLE_INTERVAL_SECS=30                  # publish every 30s instead of 60s
# ORACLE_MAX_RETRIES=5                     # retry budget per cycle
# ORACLE_FEED_TIMEOUT_SECS=10              # HTTP timeout against dcswap.net
# ORACLE_RPC_TIMEOUT_SECS=30               # local rope-node RPC timeout
# ORACLE_NO_AUTO_CREATE_LEDGER=1           # require pre-created personal ledger
