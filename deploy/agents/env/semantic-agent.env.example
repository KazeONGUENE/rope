# /etc/semantic-agent/config.env
# Per-host overrides for SemanticAgent.

# Defaults already wired in the unit:
#   SEMANTIC_LISTEN=127.0.0.1:9092
#   SEMANTIC_RPC_URL=http://127.0.0.1:8545
#   SEMANTIC_AGENT_WALLET=0x…C001
#   SEMANTIC_INDEX_PATH=/var/lib/semantic-agent/index
#   SEMANTIC_POLL_INTERVAL_SECS=30
#   SEMANTIC_CHECKPOINT_INTERVAL_SECS=600
#   SEMANTIC_LOG=info,semantic_agent=info

# Useful overrides:
# SEMANTIC_POLL_INTERVAL_SECS=10                   # index more aggressively
# SEMANTIC_CHECKPOINT_INTERVAL_SECS=300            # anchor every 5 min
# SEMANTIC_INDEX_HEAP_BYTES=536870912              # 512 MiB tantivy writer heap
# SEMANTIC_MAX_RESULTS=200                         # cap /v1/search results
