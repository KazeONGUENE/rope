# /etc/datachain-agents/shared.env
# Chain-wide settings shared by every Datachain Rope canonical AI agent.
# Per-agent overrides live at /etc/<agent-name>/config.env and take
# precedence (the per-agent EnvironmentFile is loaded after this one).

# Local rope-node JSON-RPC. The agents talk to the local node only;
# they never depend on the public erpc.datachain.network endpoint.
RPC_URL=http://127.0.0.1:8545

# Default tracing filter — most useful while bringing an agent up.
# Tighten in production by setting per-agent <NAME>_LOG=warn,<name>_agent=info.
RUST_LOG=info,oracle_agent=info,validation_agent=info,insurance_agent=info,semantic_agent=info,compliance_agent=info
