# /etc/validation-agent/config.env
# Per-host overrides for ValidationAgent.

# Defaults already wired in the unit:
#   VALIDATION_RPC_URL=http://127.0.0.1:8545
#   VALIDATION_WALLET_HEX=0x…C004
#   VALIDATION_POLL_INTERVAL_SECS=5
#   VALIDATION_KEY_PATH=/etc/validation-agent/validation.seed
#   VALIDATION_LOG=info,validation_agent=info

# Useful overrides:
# VALIDATION_POLL_INTERVAL_SECS=2          # check for new anchors every 2s
# VALIDATION_ANCHOR_ONLY=1                 # only verify cord anchor knots
# VALIDATION_REQUIRE_DILITHIUM=1           # reject Ed25519-only knots
