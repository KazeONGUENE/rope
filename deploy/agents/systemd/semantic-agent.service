# /etc/systemd/system/semantic-agent.service
# Datachain Rope SemanticAgent — knot indexing, semantic search, and
# auditable index checkpoints. Polls new knots, indexes their payloads
# into a tantivy full-text index, exposes HTTP search at /v1/search,
# anchors a merkle-rooted IndexCheckpointTestimony every 10 minutes
# so the index state is on-chain auditable.
#
# Wallet: 0x000000000000000000000000000000000000C001
# Listens on: 127.0.0.1:9092 (proxied at semantic-agent.datachain.network)
# Source: crates/semantic-agent/

[Unit]
Description=Datachain Rope SemanticAgent — knot indexing + semantic search + auditable checkpoints
Documentation=https://datachain.network/docs#testimony
Documentation=https://semantic-agent.datachain.network/v1/search
Documentation=https://dcscan.io/agents
After=network-online.target datachain-rope.service
Wants=network-online.target datachain-rope.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# WorkingDirectory MUST be /var/lib/semantic-agent: the binary writes its
# tantivy index to ./semantic-agent-index/ (relative to cwd) and the
# SEMANTIC_INDEX_PATH env var is currently ignored. Combined with
# ProtectHome=read-only, any cwd under /home would crash with EROFS at
# startup. Keep this in sync with ReadWritePaths below.
WorkingDirectory=/var/lib/semantic-agent
Environment="PATH=/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin"

Environment="SEMANTIC_LISTEN=127.0.0.1:9092"
Environment="SEMANTIC_RPC_URL=http://127.0.0.1:8545"
Environment="SEMANTIC_AGENT_WALLET=0x000000000000000000000000000000000000C001"
# NOTE: currently unused by the binary — index is written to
# $WorkingDirectory/semantic-agent-index/. Kept here for forward-compat
# once the binary honours SEMANTIC_INDEX_PATH.
Environment="SEMANTIC_INDEX_PATH=/var/lib/semantic-agent/semantic-agent-index"
Environment="SEMANTIC_POLL_INTERVAL_SECS=30"
Environment="SEMANTIC_CHECKPOINT_INTERVAL_SECS=600"
Environment="SEMANTIC_LOG=info,semantic_agent=info"

EnvironmentFile=-/etc/datachain-agents/shared.env
EnvironmentFile=-/etc/semantic-agent/config.env

ExecStart=/home/ubuntu/datachain-rope/target/release/semantic-agent serve

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=semantic-agent

# Hardening — exposes a localhost HTTP listener, persists a tantivy
# index under /var/lib/semantic-agent/, otherwise read-only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/semantic-agent /etc/semantic-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
# tantivy may use jemalloc / memory-mapped files; do not deny W^X here
# without testing first.
# MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
