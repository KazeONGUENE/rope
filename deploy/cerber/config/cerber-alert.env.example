# Canonical CERBER page address for the whole mesh (Rope / DCSwap / Tanastok / Alteros).
# Install as /etc/cerber-alert.env (mode 0640) on every host that runs a CERBER unit.
#
# DCSwap already has SMTP via /opt/dcswap/bot/.env — CERBER_ALERT_EMAIL alone is enough there.
# Rope / Alteros (cerber-mesh*.service) load this file and page via deploy/cerber/lib/page-email.mjs.

CERBER_ALERT_EMAIL=contact@onguene.com

# Required on rope-vps for Alteros + Rope CERBER direct pages (SendGrid or any STARTTLS SMTP):
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=
EMAIL_FROM=Datachain CERBER <contact@datachain.one>

# Optional:
# CERBER_ALERT_COOLDOWN_MS=21600000
# CERBER_ALERT_STATE_PATH=/var/lib/datachain-rope/cerber/alert-state.json
