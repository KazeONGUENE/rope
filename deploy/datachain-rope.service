# /etc/systemd/system/datachain-rope.service
# Datachain Rope node (rope-cli start) — runs in parallel with the Reth EVM
# backend. rope-node serves the canonical JSON-RPC (Quipu Canon v1.1: rope_*
# methods + eth_* aliases) on :8545 and delegates EVM-anchored eth_* methods
# to Reth on private :8595.
#
# Prior to 2026-03 the EVM backend was Anvil (also on :8595). The unit name
# `anvil-rope.service` may still exist on legacy hosts but is superseded by
# `reth-rope.service`. The After= directive lists both so the unit composes
# cleanly on either layout.

[Unit]
Description=Datachain Rope Node (rope start)
After=network-online.target reth-rope.service anvil-rope.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/datachain-rope
Environment="PATH=/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
# Public RPC on :8545 (rope-node); EVM backend (Reth) on private :8595
# (see deploy/config/rope-production.toml [evm_backend])
ExecStart=/home/ubuntu/datachain-rope/target/release/rope node --config /home/ubuntu/datachain-rope/deploy/config/rope-production.toml --network mainnet --mode relay
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=datachain-rope

# Hardening (M6, SECURITY_AUDIT_2026-07-25_FULL_WORKSPACE.md). rope-node
# reads its config/genesis under WorkingDirectory (/home/ubuntu/datachain-rope,
# read-only is fine) and writes ONLY under its data_dir, which defaults to
# ~/.rope (i.e. /home/ubuntu/.rope) — see crates/rope-node/src/node.rs
# (ledger_db, db, keys, genesis.json, validator_key.bin, validator_set.json)
# and deploy/config/rope-production.toml's [storage].db_path /
# [governance].log_path (both under the same ~/.rope tree). No other
# on-disk write target exists in this binary.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/home/ubuntu/.rope
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RemoveIPC=yes
# rope-node's RocksDB-backed LedgerStore (Quipu Canon v2.0 Phase 1.6) and
# libp2p's networking stack both rely on mmap'd files / JIT-adjacent buffer
# handling; do not enable MemoryDenyWriteExecute without testing first
# (same caution as the existing agent-runtime units in deploy/agents/systemd/).

[Install]
WantedBy=multi-user.target
