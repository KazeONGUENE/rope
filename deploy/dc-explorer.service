# /etc/systemd/system/dc-explorer.service
# DC Explorer — block explorer UI.
# Talks to the rope-node JSON-RPC on 127.0.0.1:8545 (rope_*, eth_* aliases per
# Quipu Canon v1.1). The rope-node itself delegates EVM-anchored eth_* methods
# to the Reth EVM backend on 127.0.0.1:8595, so dc-explorer only needs the
# single rope-node endpoint.

[Unit]
Description=DC Explorer (block explorer)
After=network-online.target reth-rope.service datachain-rope.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/datachain-rope
Environment="PATH=/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RPC_URL=http://127.0.0.1:8545"
Environment="DCSCAN_STATIC=/home/ubuntu/datachain-rope/crates/rope-explorer/static"
# Optional: per-host overrides. Leading dash makes systemd tolerate missing file
# (production .env is at /opt/datachain-rope/code/deploy/.env on rope-vps; not
# present on anvil-vps where defaults above suffice).
EnvironmentFile=-/home/ubuntu/datachain-rope/.env
EnvironmentFile=-/opt/datachain-rope/code/deploy/.env
ExecStart=/home/ubuntu/datachain-rope/target/release/dc-explorer
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dc-explorer

# Hardening (M6, SECURITY_AUDIT_2026-07-25_FULL_WORKSPACE.md). dc-explorer
# reads static assets + config from WorkingDirectory (read-only is fine)
# and writes to a small, enumerable set of state files:
#   - /var/lib/dc-explorer/ (tx_count_cache.json, holder_index.json,
#     nft_index.json, api_keys.json, and anything under
#     DC_EXPLORER_STATE_DIR — see main.rs/api_keys.rs)
#   - /opt/datachain-rope/{node-requests.jsonl,projects.jsonl,
#     project-ballots.jsonl,databoxes.jsonl} (see main.rs/governance_votes.rs/
#     databox_registry.rs)
# The "-" prefix on the /opt/datachain-rope/*.jsonl entries makes systemd
# tolerate a file that doesn't exist yet at unit-start time (first boot
# after this hardening lands); operators should `touch` + `chown ubuntu:ubuntu`
# each of these once so ReadWritePaths has a concrete inode to bind over.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/dc-explorer
ReadWritePaths=-/opt/datachain-rope/node-requests.jsonl
ReadWritePaths=-/opt/datachain-rope/projects.jsonl
ReadWritePaths=-/opt/datachain-rope/project-ballots.jsonl
ReadWritePaths=-/opt/datachain-rope/databoxes.jsonl
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
