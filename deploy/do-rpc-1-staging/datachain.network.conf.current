# DO EDGE — datachain.network / erpc / ws / faucet / bridge
# Runs on datachain-rpc-1 (157.230.18.45). Mirrors the BLUE edge so that
# public traffic can be served if the Gandi primary (92.243.26.189) is down.
#
# Local services on this node: rope-node :8545, reth :8595, dc-explorer :3001.
# BLUE remains a backup upstream for RPC (and primary for agent services,
# which only run on BLUE — see agents.datachain.network.conf).

upstream rope_rpc_edge {
    server 127.0.0.1:8545 max_fails=2 fail_timeout=5s;
    server 92.243.26.189:8545 backup;   # BLUE
    server 167.172.106.174:8545 backup; # DO rpc-2
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name datachain.network www.datachain.network erpc.datachain.network ws.datachain.network faucet.datachain.network bridge.datachain.network;

    location /.well-known/acme-challenge/ {
        root /opt/datachain-rope/edge/html/acme;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main website
server {
    listen 443 ssl http2;
    server_name datachain.network www.datachain.network;

    ssl_certificate /opt/datachain-rope/ssl/datachain.network/fullchain.pem;
    ssl_certificate_key /opt/datachain-rope/ssl/datachain.network/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    root /opt/datachain-rope/edge/html/datachain;
    index index.html;

    if ($request_uri ~ ^/(.*)\.html(\?.*)?$) {
        return 301 /$1$2;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    }

    location / {
        try_files $uri $uri.html $uri/index.html $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

# RPC endpoint
server {
    listen 443 ssl http2;
    server_name erpc.datachain.network;

    ssl_certificate /opt/datachain-rope/ssl/erpc.datachain.network/fullchain.pem;
    ssl_certificate_key /opt/datachain-rope/ssl/erpc.datachain.network/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    limit_req zone=rpc burst=50 nodelay;

    # /v1/fleet-status - the canonical source is on BLUE (92.243.26.189).
    # When DNS is failed over to DO-rpc-1 (this node), BLUE is by definition
    # not the current DNS target and may be unreachable. We return a well-formed
    # 503 with an honest marker so CERBER R12 sees an \"unavailable\" state
    # rather than a \"Parse error\" (which is treated as unmonitored).
    location = /v1/fleet-status {
        return 503 '{"status":"failover_no_fleet_status","served_by":"do-rpc-1","note":"you are talking to DO-rpc-1 because erpc.datachain.network has failed over from BLUE; fleet-status is only generated on BLUE. Treat edge=degraded and writer=unknown during this window.","canonical_when_blue_up":"https://erpc.datachain.network/v1/fleet-status"}';
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-store" always;
    }
    location = /v1/fleet-status.signed.json {
        return 503 '{"status":"failover_no_fleet_status","served_by":"do-rpc-1","canonical_when_blue_up":"https://erpc.datachain.network/v1/fleet-status.signed.json"}';
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-store" always;
    }
    location = /v1/fleet-status.sig.json {
        return 503 '{"status":"failover_no_fleet_status","served_by":"do-rpc-1","canonical_when_blue_up":"https://erpc.datachain.network/v1/fleet-status.sig.json"}';
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "no-store" always;
    }

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;

        proxy_pass http://rope_rpc_edge;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # V11: strip any inbound internal-bypass header (see SECURITY_AUDIT_2026-06-11.md)
        proxy_set_header X-Rope-Internal-Token "";

        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_timeout 15s;
        proxy_next_upstream_tries 2;

        proxy_buffering off;
        proxy_request_buffering off;

        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
    }
}

# WebSocket endpoint
server {
    listen 443 ssl http2;
    server_name ws.datachain.network;

    ssl_certificate /opt/datachain-rope/ssl/ws.datachain.network/fullchain.pem;
    ssl_certificate_key /opt/datachain-rope/ssl/ws.datachain.network/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://rope_rpc_edge;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Rope-Internal-Token "";

        proxy_connect_timeout 2s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_timeout 10s;
        proxy_next_upstream_tries 2;
    }
}

# Faucet
server {
    listen 443 ssl http2;
    server_name faucet.datachain.network;

    ssl_certificate /opt/datachain-rope/ssl/faucet.datachain.network/fullchain.pem;
    ssl_certificate_key /opt/datachain-rope/ssl/faucet.datachain.network/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/datachain-rope/edge/html/faucet;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Bridge
server {
    listen 443 ssl http2;
    server_name bridge.datachain.network;

    ssl_certificate /opt/datachain-rope/ssl/bridge.datachain.network/fullchain.pem;
    ssl_certificate_key /opt/datachain-rope/ssl/bridge.datachain.network/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/datachain-rope/edge/html/bridge;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
