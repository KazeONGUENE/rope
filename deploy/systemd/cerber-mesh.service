[Unit]
Description=Datachain CERBER mesh (signed Rope verification + peer gossip)
After=network-online.target datachain-rope.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/datachain-rope/cerber
# Mesh-wide page address (same mailbox as DCSwap R13 / every CERBER peer).
EnvironmentFile=-/etc/cerber-alert.env
Environment=CERBER_PEER_ID=cerber-rope
Environment=CERBER_PEER_ROLE=rope
Environment=CERBER_IDENTITY_KEY=/var/lib/datachain-rope/cerber/identity.pem
Environment=CERBER_AUDIT_DIR=/var/lib/datachain-rope/cerber/audit
Environment=CERBER_PEERS_FILE=/opt/datachain-rope/cerber/config/peers.production.json
Environment=CERBER_PEERS_RUNTIME=/var/lib/datachain-rope/cerber/peers.runtime.json
Environment=CERBER_MESH_HOST=0.0.0.0
Environment=CERBER_MESH_PORT=9107
Environment=CERBER_FLEET_STATUS_FILE=/opt/datachain-rope/code/deploy/nginx/html/fleet/fleet-status.json
Environment=CERBER_FLEET_STATUS_SIG_FILE=/opt/datachain-rope/code/deploy/nginx/html/fleet/fleet-status.sig.json
Environment=CERBER_ROPE_RPC=http://127.0.0.1:8545
Environment=CERBER_TRUST_BOOTSTRAP=1
Environment=CERBER_VERIFY_INTERVAL_MS=60000
Environment=CERBER_HEARTBEAT_INTERVAL_MS=45000
Environment=CERBER_REPORT_INTERVAL_MS=120000
Environment=CERBER_ALERT_EMAIL=contact@onguene.com
# Optional peer overrides once remote CERBER instances listen:
# Environment=CERBER_PEER_DCSWAP_URL=http://92.243.26.114:9107
# Environment=CERBER_PEER_TANASTOK_URL=http://92.243.24.244:9107
# Environment=CERBER_PEER_ALTEROS_URL=http://<alteros-host>:9107
ExecStart=/usr/bin/node /opt/datachain-rope/cerber/bin/cerber-mesh.mjs serve
Restart=always
RestartSec=5
Nice=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
