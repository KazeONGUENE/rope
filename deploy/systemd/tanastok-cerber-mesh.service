[Unit]
Description=Tanastok CERBER mesh peer (cerber-tanastok)
Documentation=file:/opt/tanastok/cerber-mesh/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tanastok/cerber-mesh
EnvironmentFile=-/etc/cerber-alert.env
Environment=CERBER_PEER_ID=cerber-tanastok
Environment=CERBER_PEER_ROLE=tanastok
Environment=CERBER_IDENTITY_KEY=/var/lib/cerber/tanastok-mesh-identity.pem
Environment=CERBER_AUDIT_DIR=/var/lib/cerber/mesh-audit
Environment=CERBER_LATEST_REPORT=/var/lib/cerber/latest-report.json
Environment=CERBER_DETAILED_REPORT_PATH=/var/lib/cerber/detailed-report.json
Environment=CERBER_DETAILED_REPORT_PUBLIC=/var/lib/cerber/detailed-report.public.json
Environment=CERBER_PEERS_FILE=/opt/tanastok/cerber-mesh/config/peers.tanastok.json
Environment=CERBER_PEERS_RUNTIME=/var/lib/cerber/peers.runtime.json
Environment=CERBER_MESH_HOST=0.0.0.0
Environment=CERBER_MESH_PORT=9107
Environment=CERBER_PUBLIC_MESH_URL=http://92.243.24.244:9107
Environment=CERBER_ROPE_RPC=https://erpc.datachain.network
Environment=CERBER_FLEET_STATUS_URL=https://erpc.datachain.network/v1/fleet-status
Environment=CERBER_FLEET_STATUS_SIG_URL=https://erpc.datachain.network/v1/fleet-status.sig.json
Environment=CERBER_TRUST_BOOTSTRAP=1
Environment=CERBER_VERIFY_INTERVAL_MS=120000
Environment=CERBER_HEARTBEAT_INTERVAL_MS=45000
Environment=CERBER_REPORT_INTERVAL_MS=180000
Environment=CERBER_ALERT_EMAIL=contact@onguene.com
ExecStart=/usr/bin/node /opt/tanastok/cerber-mesh/bin/cerber-mesh.mjs serve
Restart=always
RestartSec=5
Nice=5
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
